    "public_key": "pk_fetchai_route_v1_0x4D5E6F7A8B9C0D1E2F3A4B5C6D7E8F9A0B1C2D3E",
    "settlement": {
      "supported_chains_or_gateways": ["Base", "Solana"],
      "wallet_address": "0xBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
    }
  }
