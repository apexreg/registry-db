    "public_key": "pk_autogen_code_v1_0x6F7A8B9C0D1E2F3A4B5C6D7E8F9A0B1C2D3E4F5A",
    "settlement": {
      "supported_chains_or_gateways": ["Base", "Stripe"],
      "wallet_address": "0xCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC"
    }
  }
}
