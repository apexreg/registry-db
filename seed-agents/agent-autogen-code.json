    "output_schema": {
      "type": "object",
      "properties": {
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "exit_code": { "type": "integer" },
        "execution_time_ms": { "type": "number" }
      }
    }
  },
  "trust_and_verification": {
