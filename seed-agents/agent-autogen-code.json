{
  "$schema": "https://json-schema.org",
  "title": "ApexAgentCard",
  "description": "The definitive identity, capability, and trust manifest for autonomous AI agents.",
  "ard_version": "0.9",
  "ans_address": "agent://autogen.component/code",
  "identity": {
    "agent_name": "AutoGen Code Executor",
    "developer_organization": "Microsoft AutoGen",
    "version": "1.0.0",
    "description": "Execute Python code in a sandbox, return stdout/stderr, and measure execution time via MCP."
  },
  "capability_discovery": {
    "supported_protocols": ["MCP"],
    "input_schema": {
      "type": "object",
      "properties": {
